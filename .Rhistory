library(data.table)
rutas_archivos <- c(
"cruce_1" = "C:/Users/Invitadou/Downloads/Cruce Examen Saber 11 - Examen Saber Pro (3).txt"
)
variables_requeridas <- c(
"estu_consecutivo_sb11",
"periodo_sb11",
"estu_consecutivo_sbpro",
"periodo_sbpro"
)
lista_bases <- list()
for (nombre_archivo in names(rutas_archivos)) {
ruta <- rutas_archivos[[nombre_archivo]]
cat("\nLeyendo:", nombre_archivo, "\n")
cat(ruta, "\n")
# Leer archivo
datos <- fread(
ruta,
sep = "auto",
encoding = "UTF-8",
header = TRUE,
check.names = FALSE,
strip.white = TRUE
)
# Limpiar nombres de columnas
names(datos) <- trimws(names(datos))
# Verificar variables requeridas
faltantes <- setdiff(
variables_requeridas,
names(datos)
)
if (length(faltantes) > 0) {
stop(
paste0(
"\nERROR en ",
nombre_archivo,
"\nFaltan las variables:\n",
paste(faltantes, collapse = ", ")
)
)
}
# Conservar únicamente las 4 variables del cruce (Usando selección segura)
cols_iniciales <- c("estu_consecutivo_sb11", "periodo_sb11", "estu_consecutivo_sbpro", "periodo_sbpro")
datos <- datos[, cols_iniciales, with = FALSE]
# Agregar a la lista
lista_bases[[nombre_archivo]] <- datos
}
base_cruces <- rbindlist(
lista_bases,
use.names = TRUE,
fill = FALSE
)
cat("\n============================================\n")
cat("BASES UNIFICADAS\n")
cat("============================================\n")
cat(
"Registros iniciales:",
nrow(base_cruces),
"\n"
)
base_cruces[, periodo_sb11 := trimws(as.character(periodo_sb11))]
base_cruces[, periodo_sbpro := trimws(as.character(periodo_sbpro))]
base_cruces[, periodo_sb11_num := suppressWarnings(as.integer(periodo_sb11))]
base_cruces[, periodo_sbpro_num := suppressWarnings(as.integer(periodo_sbpro))]
# Extraer el año (primeros 4 dígitos, ej: 20141 %/% 10 = 2014) para incluir todos los períodos
base_cruces[, anio_sb11 := periodo_sb11_num %/% 10]
base_cruces[, anio_sbpro := periodo_sbpro_num %/% 10]
base_cruces <- base_cruces[anio_sb11 >= 2014 & anio_sb11 <= 2025]
base_cruces <- base_cruces[anio_sbpro >= 2014 & anio_sbpro <= 2025]
base_cruces[
,
rezago_semestres :=
(
(periodo_sbpro_num %/% 10) -
(periodo_sb11_num %/% 10)
) * 2 +
(
(periodo_sbpro_num %% 10) -
(periodo_sb11_num %% 10)
)
]
cols_finales <- c("estu_consecutivo_sb11", "periodo_sb11", "estu_consecutivo_sbpro", "periodo_sbpro", "rezago_semestres")
base_cruces <- unique(base_cruces[, cols_finales, with = FALSE])
setorder(
base_cruces,
periodo_sb11,
periodo_sbpro
)
base_final <- base_cruces
cat("\n============================================\n")
cat("RESULTADO FINAL Y AUDITORÍA\n")
cat("============================================\n")
cat(
"Total de emparejamientos válidos:",
nrow(base_final),
